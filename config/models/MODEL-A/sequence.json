
{
    "sequence_id": "test_sequence",
    "name": "Safety Test Sequence",
    "version": 1,
    "steps": [
        {
            "id": "step_001",
            "type": "validate_serial",
            "name": "Validate Serial Number",
            "enabled": true,
            "parameters": {
                "source": "serial_number",
                "min_length": 1,
                "max_length": 50
            }
        },
        {
            "id": "step_002",
            "type": "input",
            "name": "Scan Door Top",
            "enabled": true,
            "parameters": {
                "field": "door_top",
                "label": "Door Top Barcode",
                "placeholder": "Scan Door Top Barcode",
                "required": true
            }
        },
        {
            "id": "step_003",
            "type": "input",
            "name": "Scan Door Bottom",
            "enabled": true,
            "parameters": {
                "field": "door_bottom",
                "label": "Door Bottom Barcode",
                "placeholder": "Scan Door Bottom Barcode",
                "required": true
            }
        },
        {
            "id": "step_004",
            "type": "instrument_test",
            "name": "AC Hipot Test",
            "enabled": true,
            "parameters": {
                "instrument": "kikusui_tos9302",
                "function": "acw"
            }
        },
        {
            "id": "step_005",
            "type": "ac_volt_confirmation",
            "name": "AC Volt Confirmation",
            "enabled": true,
            "parameters": {
                "power_supply": "kikusui_pcr500m",
                "power_meter": "wt310e",
                "measurements": [
                    "voltage",
                    "current",
                    "active_power",
                    "current_frequency",
                    "voltage_frequency"
                ]
            }
        },
        {
            "id": "build_final_result",
            "type": "build_result",
            "name": "Build Final Result",
            "enabled": true,
            "parameters": {}
        },
        {
            "id": "save_final_result",
            "type": "save_result",
            "name": "Save Final Result",
            "enabled": true,
            "parameters": {
                "source": "result"
            }
        }
    ]
}
